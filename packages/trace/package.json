{
    "name": "@begame/trace",
    "version": "0.0.2",
    "description": "BEGame Trace runtime: session manager and world history store",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": ["dist"],
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./*": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js"
        }
    },
    "dependencies": {
        "@begame/core": "0.0.2",
        "@begame/trace-core": "0.0.2"
    },
    "peerDependencies": {
        "@minecraft/server": ">=2.9.0"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/XiaoYangx666/SAPI-Game.git"
    },
    "keywords": ["minecraft", "bedrock", "trace", "runtime"]
}
