{
    "name": "@begame/trace-core",
    "version": "0.0.2",
    "description": "Platform-independent BEGame Trace format, codec and session primitives",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": ["dist"],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
