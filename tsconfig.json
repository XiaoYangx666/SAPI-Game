{
    "compilerOptions": {
        "target": "es2023",
        "moduleResolution": "bundler",
        "module": "esnext",
        "lib": ["ES2022", "DOM", "ES2023.Array"],
        "types": [],
        "declaration": true,
        "sourceMap": false,
        "pretty": true,
        "forceConsistentCasingInFileNames": true,
        "preserveConstEnums": true,
        "strict": true,
        "noImplicitAny": true,
        "noImplicitOverride": true,
        "allowJs": true,
        "paths": {
            "@begame/core": ["./packages/core/src/main.ts"],
            "@begame/core/*": ["./packages/core/src/*"],
            "@begame/test": ["./packages/test/src/index.ts"],
            "@begame/test/*": ["./packages/test/src/*"],
            "@sapi-game/*": ["./packages/core/src/*"]
        }
    },
    "include": [
        "./packages/core/src",
        "./packages/test/src"
    ],
    "compileOnSave": false
}
