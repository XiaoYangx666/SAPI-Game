{
    "compilerOptions": {
        "target": "es2023",
        "moduleResolution": "bundler",
        "module": "esnext",
        "lib": ["ES2022", "DOM", "ES2023.Array"],
        "types": [],
        "declaration": true,
        "sourceMap": false,
        "pretty": true,
        "forceConsistentCasingInFileNames": true,
        "preserveConstEnums": true,
        "strict": true,
        "noImplicitAny": true,
        "noImplicitOverride": true,
        "outDir": "dist",
        "rootDir": "src",
        "allowJs": true,
        "paths": {
            "@sapi-game/*": ["./src/*"]
        }
    },
    "tsc-alias": {
        "resolveFullPaths": true
    },
    "include": ["./src"],
    "compileOnSave": false
}
