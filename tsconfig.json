{
    "compilerOptions": {
        "target": "esnext",
        "moduleResolution": "bundler",
        "module": "esnext",
        "lib": ["ESNext", "DOM"],
        "types": [],
        "declaration": false,
        "noLib": false,
        "sourceMap": false,
        "pretty": true,
        "forceConsistentCasingInFileNames": true,
        "preserveConstEnums": true,
        "strict": true,
        "noImplicitAny": true,
        "noImplicitOverride": true,
        "outDir": "scripts",
        "rootDir": "src",
        "allowJs": true,
        "paths": {
            "@sapi-game/*": ["./src/*"]
        }
    },
    "include": ["./src"],
    "compileOnSave": false
}
