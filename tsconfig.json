{
    "compilerOptions": {
        "target": "es2023",
        "moduleResolution": "bundler",
        "module": "esnext",
        "lib": ["ES2022", "DOM", "ES2023.Array"],
        "types": [],
        "declaration": true,
        "sourceMap": false,
        "pretty": true,
        "forceConsistentCasingInFileNames": true,
        "preserveConstEnums": true,
        "strict": true,
        "noImplicitAny": true,
        "noImplicitOverride": true,
        "allowJs": true,
        "paths": {
            "@begame/core": ["./src/main.ts"],
            "@begame/core/*": ["./src/*"],
            "@begame/test": ["./src/testing/index.ts"],
            "@begame/test/*": ["./src/testing/*"],
            "@sapi-game/*": ["./src/*"]
        }
    },
    "include": ["./src", "./vitest.config.ts"],
    "compileOnSave": false
}
