{
    "name": "sapi-game",
    "version": "0.0.2",
    "description": "make mini game fully by sapi",
    "main": "dist/main.js",
    "types": "dist/main.d.ts",
    "type": "module",
    "author": {
        "name": "XiaoYangx666",
        "email": "2408807389@qq.com"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/XiaoYangx666/SAPI-Game.git"
    },
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/main.d.ts",
            "import": "./dist/main.js"
        },
        "./gameComponent": {
            "types": "./dist/gameComponent/index.d.ts",
            "import": "./dist/gameComponent/index.js"
        },
        "./gameEvent": {
            "types": "./dist/gameEvent/index.d.ts",
            "import": "./dist/gameEvent/index.js"
        },
        "./gamePlayer": {
            "types": "./dist/gamePlayer/index.d.ts",
            "import": "./dist/gamePlayer/index.js"
        },
        "./gameRegion": {
            "types": "./dist/gameRegion/index.d.ts",
            "import": "./dist/gameRegion/index.js"
        },
        "./gameState": {
            "types": "./dist/gameState/index.d.ts",
            "import": "./dist/gameState/index.js"
        },
        "./utils": {
            "types": "./dist/utils/index.d.ts",
            "import": "./dist/utils/index.js"
        },
        "./gameStructure": {
            "types": "./dist/gameStructure/gameStructure.d.ts",
            "import": "./dist/gameStructure/gameStructure.js"
        },
        "./*": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js"
        }
    },
    "peerDependencies": {
        "@minecraft/server": ">=2.3.0 <3.0.0",
        "@minecraft/server-ui": ">=2.0.0 <3.0.0"
    },
    "scripts": {
        "clean": "rimraf dist || true",
        "build": "npm run clean && tsc --noEmit && rolldown -c",
        "prepare": "npm run build"
    },
    "devDependencies": {
        "rimraf": "^6.1.2",
        "rolldown": "^1.1.5",
        "rolldown-plugin-dts": "^0.27.6",
        "tinyglobby": "^0.2.17",
        "typescript": "^7.0.2"
    },
    "keywords": [
        "minecraft",
        "bedrock",
        "bedrock-edition",
        "ScriptApi",
        "library",
        "miniGame"
    ]
}
