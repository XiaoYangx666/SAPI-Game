{
    "name": "begame-monorepo",
    "private": true,
    "version": "0.0.2",
    "description": "BEGame - Minecraft Bedrock game lifecycle framework",
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "clean": "rimraf packages/core/dist packages/test/dist packages/trace-tools/dist || true",
        "build": "npm run clean && tsc --noEmit && rolldown -c",
        "test": "vitest run",
        "test:unit": "vitest run",
        "test:headless": "vitest run tests/lifecycle.test.mjs",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "rimraf": "^6.1.2",
        "rolldown": "^1.1.5",
        "rolldown-plugin-dts": "^0.27.6",
        "tinyglobby": "^0.2.17",
        "typescript": "^7.0.2",
        "vitest": "^5.0.0"
    }
}
