{
    "name": "begame-monorepo",
    "private": true,
    "version": "0.0.2",
    "description": "BEGame - Minecraft Bedrock game lifecycle framework",
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "clean": "rimraf packages/core/dist packages/test/dist packages/trace/dist packages/trace-spec/dist packages/observatory/dist packages/observatory/public/build || true",
        "build": "npm run clean && tsc --noEmit && tsc -p packages/observatory/server && rolldown -c",
        "pack": "node scripts/pack.mjs",
        "test": "vitest run",
        "test:unit": "vitest run",
        "test:treeshake": "node scripts/treeshake-probe.mjs",
        "test:headless": "vitest run tests/lifecycle.test.mjs",
        "test:watch": "vitest",
        "observatory": "npm run build && node packages/observatory/dist/server.js"
    },
    "devDependencies": {
        "@minecraft/server": "2.10.0",
        "@minecraft/server-ui": "2.2.0",
        "@minecraft/vanilla-data": "1.26.51",
        "rimraf": "^6.1.2",
        "rolldown": "^1.1.5",
        "rolldown-plugin-dts": "^0.27.6",
        "tinyglobby": "^0.2.17",
        "typescript": "^7.0.2",
        "vitest": "^5.0.0"
    }
}
